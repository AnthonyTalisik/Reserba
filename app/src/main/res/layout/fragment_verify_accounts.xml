<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="16dp"
    android:paddingEnd="16dp">

    <TextView
        style="@style/Reserba.H1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Verify accounts" />

    <TextView
        android:id="@+id/tvInfo"
        style="@style/Reserba.Muted"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp" />

    <TextView
        style="@style/Reserba.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_badge_blue"
        android:padding="10dp"
        android:text="Check each name and ID number against school records before approving."
        android:textColor="@color/primary"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tvEmpty"
        style="@style/Reserba.Muted"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="24dp"
        android:text="No accounts are waiting for verification."
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvAccounts"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="12dp" />
</LinearLayout>
